{
  "name": "roster-lab",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vite",
    "build": "tsc -b && WRANGLER_LOG_PATH=.wrangler/wrangler.log vite build",
    "ml:collect": ".venv/bin/python ml/pipeline.py collect",
    "ml:train": ".venv/bin/python ml/pipeline.py train",
    "ml:refresh": ".venv/bin/python ml/pipeline.py refresh",
    "ml:test": ".venv/bin/python -m unittest ml/test_pipeline.py",
    "test": "vitest run --config vitest.config.ts",
    "preview": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vite preview"
  },
  "dependencies": {
    "lucide-react": "^1.31.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.51.1",
    "@types/node": "^26.2.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.5",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vitest": "^4.1.10",
    "wrangler": "^4.120.0"
  }
}
