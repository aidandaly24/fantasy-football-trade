{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "roster-lab",
  "main": "worker/index.ts",
  "compatibility_date": "2026-08-08",
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "triggers": {
    "crons": ["*/5 * * * *"]
  }
}
